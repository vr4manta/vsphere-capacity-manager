import { fileURLToPath } from 'url';
import { dirname } from 'path';
import * as path from 'path';
import webpack from 'webpack';
import type { Configuration as DevServerConfiguration } from 'webpack-dev-server';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

interface WebpackConfiguration extends webpack.Configuration {
  devServer?: DevServerConfiguration;
}

const config = (env: any, argv: any): WebpackConfiguration => {
  const isDevelopment = argv.mode === 'development';

  return {
    mode: argv.mode || 'development',
    entry: {
      plugin: './src/index.tsx',
      'plugin-code': './src/plugin.ts',
    },
    output: {
      path: path.resolve(__dirname, 'dist'),
      filename: '[name]-bundle.js',
      chunkFilename: '[name]-chunk.js',
      publicPath: '/',
      library: {
        type: 'commonjs2',
      },
    },
    resolve: {
      extensions: ['.ts', '.tsx', '.js', '.jsx'],
      alias: {
        '@components': path.resolve(__dirname, 'src/components'),
        '@vcm-types': path.resolve(__dirname, 'src/types'),
        '@hooks': path.resolve(__dirname, 'src/hooks'),
        '@api': path.resolve(__dirname, 'src/api'),
        '@utils': path.resolve(__dirname, 'src/utils'),
      },
    },
    module: {
      rules: [
        {
          test: /\.tsx?$/,
          use: 'ts-loader',
          exclude: /node_modules/,
        },
        {
          test: /\.css$/,
          use: ['style-loader', 'css-loader'],
        },
        {
          test: /\.s[ac]ss$/i,
          use: ['style-loader', 'css-loader', 'sass-loader'],
        },
        {
          test: /\.(png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$/,
          type: 'asset/resource',
        },
      ],
    },
    devServer: isDevelopment
      ? {
          static: {
            directory: path.join(__dirname, 'dist'),
          },
          port: 9000,
          hot: true,
          headers: {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, PATCH, OPTIONS',
            'Access-Control-Allow-Headers': 'X-Requested-With, content-type, Authorization',
          },
        }
      : undefined,
    plugins: [
      new webpack.DefinePlugin({
        'process.env.NODE_ENV': JSON.stringify(argv.mode || 'development'),
      }),
    ],
    devtool: isDevelopment ? 'source-map' : false,
    externals: [
      // Function to externalize all @console/* modules
      function ({ request }, callback) {
        if (request && request.startsWith('@console/')) {
          return callback(undefined, `commonjs ${request}`);
        }
        callback();
      },
      {
        // React and PatternFly are provided by the console
        react: 'react',
        'react-dom': 'react-dom',
        'react-router-dom': 'react-router-dom',
      },
    ],
  };
};

export default config;
