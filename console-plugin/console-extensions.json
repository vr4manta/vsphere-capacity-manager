    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/vcm/pools/:namespace/:name",
      "component": { "$codeRef": "PoolDetail.PoolDetail" }
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/vcm/pools/:namespace/:name/edit",
      "component": { "$codeRef": "PoolForm.PoolForm" }
